{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.business-online.no/qcp/v1.json",
  "title": "QCP File v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "exported_at", "exported_from", "qcp"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.\\d+$" },
    "exported_at": { "type": "string", "format": "date-time" },
    "exported_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_host", "web_part_version"],
      "properties": {
        "tenant_host": { "type": "string", "minLength": 1, "maxLength": 200 },
        "web_part_version": { "type": "string", "minLength": 1, "maxLength": 50 }
      }
    },
    "qcp": { "$ref": "#/definitions/qcp" }
  },
  "definitions": {
    "qcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "version", "binding", "phases"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 },
        "version": {
          "type": "object",
          "additionalProperties": false,
          "required": ["major", "minor"],
          "properties": {
            "major": { "type": "integer", "minimum": 0 },
            "minor": { "type": "integer", "minimum": 0 }
          }
        },
        "binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["list_name", "column_name", "column_value"],
          "properties": {
            "list_name": { "type": "string", "minLength": 1, "maxLength": 200 },
            "column_name": { "type": "string", "minLength": 1, "maxLength": 200 },
            "column_value": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/definitions/phase" }
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "sort_order", "process_details"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sort_order": { "type": "integer", "minimum": 1 },
        "process_details": {
          "type": "array",
          "minItems": 0,
          "maxItems": 200,
          "items": { "$ref": "#/definitions/processDetail" }
        }
      }
    },
    "processDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "sort_order", "na", "comment_mandatory", "links", "work_files", "triggers", "trigger_forms", "dependencies", "highlight"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 50000 },
        "sort_order": { "type": "integer", "minimum": 1 },
        "na": { "type": "boolean" },
        "comment_mandatory": { "type": "boolean" },
        "links": { "type": "array", "items": { "$ref": "#/definitions/link" } },
        "work_files": { "type": "array", "items": { "$ref": "#/definitions/workFile" } },
        "triggers": { "type": "array", "items": { "$ref": "#/definitions/trigger" } },
        "trigger_forms": { "type": "array", "items": { "$ref": "#/definitions/triggerForm" } },
        "dependencies": { "type": "array", "items": { "$ref": "#/definitions/dependency" } },
        "highlight": { "$ref": "#/definitions/highlight" }
      }
    },
    "link": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "label", "url"],
          "properties": {
            "type": { "const": "external" },
            "label": { "type": "string", "minLength": 1, "maxLength": 200 },
            "url": { "type": "string", "format": "uri", "maxLength": 2000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "label", "doc_name"],
          "properties": {
            "type": { "const": "governing_document" },
            "label": { "type": "string", "minLength": 1, "maxLength": 200 },
            "doc_name": { "type": "string", "minLength": 1, "maxLength": 400 }
          }
        }
      ]
    },
    "workFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_name", "label"],
      "properties": {
        "doc_name": { "type": "string", "minLength": 1, "maxLength": 400 },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_status", "field_type", "list_name", "field_name", "value"],
          "properties": {
            "action_status": { "enum": ["Started", "Completed", "Deviation"] },
            "field_type": { "const": "Choice" },
            "list_name": { "type": "string", "minLength": 1, "maxLength": 200 },
            "field_name": { "type": "string", "minLength": 1, "maxLength": 200 },
            "value": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action_status", "field_type", "list_name", "field_name", "days_offset"],
          "properties": {
            "action_status": { "enum": ["Started", "Completed", "Deviation"] },
            "field_type": { "const": "DateTime" },
            "list_name": { "type": "string", "minLength": 1, "maxLength": 200 },
            "field_name": { "type": "string", "minLength": 1, "maxLength": 200 },
            "days_offset": { "type": "integer", "minimum": -3650, "maximum": 3650 }
          }
        }
      ]
    },
    "triggerForm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hub", "list_name", "form_name"],
      "properties": {
        "hub": { "type": "string", "minLength": 1, "maxLength": 200 },
        "list_name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "form_name": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_title", "detail_title"],
      "properties": {
        "phase_title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "detail_title": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "highlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["add_to_timeline", "send_notification"],
      "properties": {
        "add_to_timeline": { "type": "boolean" },
        "send_notification": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["email"],
              "properties": {
                "email": { "type": "string", "format": "email", "maxLength": 200 },
                "display_name": { "type": "string", "maxLength": 200 }
              }
            }
          ]
        }
      }
    }
  }
}
